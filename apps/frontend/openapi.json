{
  "components": {
    "schemas": {
      "AppliedFilter": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "required": [
          "field",
          "label"
        ],
        "title": "AppliedFilter",
        "type": "object"
      },
      "BestMatchData": {
        "additionalProperties": false,
        "properties": {
          "corpus_size": {
            "minimum": 0.0,
            "title": "Corpus Size",
            "type": "integer"
          },
          "filters_applied": {
            "items": {
              "$ref": "#/components/schemas/AppliedFilter"
            },
            "title": "Filters Applied",
            "type": "array"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/BestMatchPosting"
            },
            "title": "Results",
            "type": "array"
          },
          "terms": {
            "items": {
              "type": "string"
            },
            "title": "Terms",
            "type": "array"
          },
          "trace": {
            "items": {
              "$ref": "#/components/schemas/TraceNode"
            },
            "title": "Trace",
            "type": "array"
          }
        },
        "required": [
          "query",
          "terms",
          "results",
          "filters_applied",
          "corpus_size",
          "trace"
        ],
        "title": "BestMatchData",
        "type": "object"
      },
      "BestMatchPosting": {
        "additionalProperties": false,
        "properties": {
          "company": {
            "title": "Company",
            "type": "string"
          },
          "evidence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RankingEvidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "first_seen_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Seen At"
          },
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "posted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Posted At"
          },
          "remote_policy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RemotePolicy"
              },
              {
                "type": "null"
              }
            ]
          },
          "salary_max": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salary Max"
          },
          "salary_min": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salary Min"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "seniority": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PostingSeniority"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "$ref": "#/components/schemas/SourceId"
          },
          "stack": {
            "items": {
              "type": "string"
            },
            "title": "Stack",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          },
          "years_required": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Years Required"
          }
        },
        "required": [
          "id",
          "source",
          "url",
          "title",
          "company",
          "score"
        ],
        "title": "BestMatchPosting",
        "type": "object"
      },
      "BestMatchRequest": {
        "additionalProperties": false,
        "properties": {
          "filters": {
            "$ref": "#/components/schemas/PostingFilters"
          },
          "profile_text": {
            "default": "",
            "maxLength": 50000,
            "title": "Profile Text",
            "type": "string"
          },
          "query": {
            "default": "",
            "maxLength": 500,
            "title": "Query",
            "type": "string"
          }
        },
        "title": "BestMatchRequest",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "EMPTY_SEARCH",
          "INVALID_REQUEST",
          "POSTING_NOT_FOUND",
          "VALIDATION_ERROR",
          "RATE_LIMITED",
          "SEARCH_UNAVAILABLE",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "required": [
          "error",
          "meta"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "LiteralHit": {
        "additionalProperties": false,
        "properties": {
          "fields": {
            "items": {
              "type": "string"
            },
            "title": "Fields",
            "type": "array"
          },
          "term": {
            "title": "Term",
            "type": "string"
          }
        },
        "required": [
          "term"
        ],
        "title": "LiteralHit",
        "type": "object"
      },
      "MetaData": {
        "additionalProperties": false,
        "properties": {
          "corpus_size": {
            "minimum": 0.0,
            "title": "Corpus Size",
            "type": "integer"
          },
          "retrieval": {
            "title": "Retrieval",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceId"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "corpus_size",
          "sources",
          "retrieval"
        ],
        "title": "MetaData",
        "type": "object"
      },
      "PaginationMeta": {
        "additionalProperties": false,
        "properties": {
          "page": {
            "minimum": 1.0,
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "minimum": 1.0,
            "title": "Page Size",
            "type": "integer"
          },
          "total_items": {
            "minimum": 0.0,
            "title": "Total Items",
            "type": "integer"
          },
          "total_pages": {
            "minimum": 0.0,
            "title": "Total Pages",
            "type": "integer"
          }
        },
        "required": [
          "page",
          "page_size",
          "total_items",
          "total_pages"
        ],
        "title": "PaginationMeta",
        "type": "object"
      },
      "PostedWithin": {
        "enum": [
          "24h",
          "7d",
          "30d"
        ],
        "title": "PostedWithin",
        "type": "string"
      },
      "PostingFilters": {
        "additionalProperties": false,
        "properties": {
          "experience_years": {
            "anyOf": [
              {
                "maximum": 60.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Experience Years"
          },
          "include_undisclosed_salary": {
            "default": false,
            "title": "Include Undisclosed Salary",
            "type": "boolean"
          },
          "min_salary": {
            "anyOf": [
              {
                "maximum": 1000000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Salary"
          },
          "posted_within": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PostedWithin"
              },
              {
                "type": "null"
              }
            ]
          },
          "remote_policy": {
            "items": {
              "$ref": "#/components/schemas/RemoteFilter"
            },
            "maxItems": 3,
            "title": "Remote Policy",
            "type": "array"
          },
          "seniority": {
            "items": {
              "$ref": "#/components/schemas/SeniorityFilter"
            },
            "maxItems": 6,
            "title": "Seniority",
            "type": "array"
          },
          "source": {
            "items": {
              "$ref": "#/components/schemas/SourceId"
            },
            "maxItems": 7,
            "title": "Source",
            "type": "array"
          }
        },
        "title": "PostingFilters",
        "type": "object"
      },
      "PostingSeniority": {
        "enum": [
          "intern",
          "junior",
          "mid",
          "senior",
          "lead",
          "principal",
          "unknown"
        ],
        "title": "PostingSeniority",
        "type": "string"
      },
      "RankingEvidence": {
        "additionalProperties": false,
        "properties": {
          "literal_hits": {
            "items": {
              "$ref": "#/components/schemas/LiteralHit"
            },
            "title": "Literal Hits",
            "type": "array"
          },
          "retrieved_sections": {
            "items": {
              "type": "string"
            },
            "title": "Retrieved Sections",
            "type": "array"
          }
        },
        "title": "RankingEvidence",
        "type": "object"
      },
      "RemoteFilter": {
        "enum": [
          "remote",
          "hybrid",
          "onsite"
        ],
        "title": "RemoteFilter",
        "type": "string"
      },
      "RemotePolicy": {
        "enum": [
          "remote",
          "hybrid",
          "onsite",
          "unknown"
        ],
        "title": "RemotePolicy",
        "type": "string"
      },
      "ResponseMeta": {
        "additionalProperties": false,
        "properties": {
          "pagination": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PaginationMeta"
              },
              {
                "type": "null"
              }
            ]
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "took_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Took Ms"
          }
        },
        "required": [
          "request_id"
        ],
        "title": "ResponseMeta",
        "type": "object"
      },
      "SeniorityFilter": {
        "enum": [
          "intern",
          "junior",
          "mid",
          "senior",
          "lead",
          "principal"
        ],
        "title": "SeniorityFilter",
        "type": "string"
      },
      "SourceId": {
        "enum": [
          "greenhouse",
          "ashby",
          "lever",
          "djinni",
          "dou",
          "jobico",
          "linkedin"
        ],
        "title": "SourceId",
        "type": "string"
      },
      "SuccessResponse_BestMatchData_": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/BestMatchData"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "SuccessResponse[BestMatchData]",
        "type": "object"
      },
      "SuccessResponse_MetaData_": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MetaData"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "SuccessResponse[MetaData]",
        "type": "object"
      },
      "TraceNode": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Count"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "node": {
            "title": "Node",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "node",
          "status",
          "detail"
        ],
        "title": "TraceNode",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Search API over the RAG pipeline",
    "title": "jobber",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/meta": {
      "get": {
        "operationId": "meta_api_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_MetaData_"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Meta"
      }
    },
    "/api/search": {
      "post": {
        "operationId": "search_api_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BestMatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse_BestMatchData_"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "summary": "Search"
      }
    }
  }
}
