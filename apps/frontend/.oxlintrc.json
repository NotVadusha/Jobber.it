{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc", "import", "typescript"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "import/no-cycle": "error",
    "import/no-relative-parent-imports": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/app/**"],
            "message": "Only the browser entrypoint can import the app layer."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/api/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/app/**"],
                "message": "The API seam is below features and the app shell."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/api/**", "@/features/**", "@/app/**"],
                "message": "lib holds dependency-free helpers only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@/api/client",
                "allowImportNames": ["ApiError"],
                "message": "Features consume api/search hooks; only ApiError may come from the transport module."
              }
            ],
            "patterns": [
              {
                "group": ["@/app/**"],
                "message": "Feature modules never import the app layer."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/main.tsx"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/app/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/routing/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/features/**", "@/ui/**"],
                "message": "Routing modules are below the app, features, and UI layers."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/features/**", "@/api/**"],
                "message": "ui foundation modules are product-agnostic and never import app, features, or API code."
              }
            ]
          }
        ]
      }
    }
  ]
}
