{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc",
    "import",
    "typescript"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "import/no-cycle": "error",
    "import/no-relative-parent-imports": "error",
    "no-restricted-globals": [
      "error",
      {
        "name": "fetch",
        "message": "Only src/api/search-stream.ts may use fetch. Everything else goes through the shared Axios instance."
      },
      {
        "name": "EventSource",
        "message": "The Best-match stream is a POST with a body; EventSource cannot send one."
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@/app/**"
            ],
            "message": "Only the browser entrypoint can import the app layer."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/api/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features/**",
                  "@/app/**"
                ],
                "message": "The API seam is below features and the app shell."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/api/search-stream.ts"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "EventSource",
            "message": "The Best-match stream is a POST with a body; EventSource cannot send one."
          }
        ]
      }
    },
    {
      "files": [
        "e2e/**"
      ],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      "files": [
        "src/lib/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/api/**",
                  "@/features/**",
                  "@/app/**"
                ],
                "message": "lib holds dependency-free helpers only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@/api/client",
                "allowImportNames": [
                  "ApiError"
                ],
                "message": "Features consume api/search hooks; only ApiError may come from the transport module."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@/app/**"
                ],
                "message": "Feature modules never import the app layer."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/main.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "src/app/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "src/routing/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/**",
                  "@/features/**",
                  "@/ui/**"
                ],
                "message": "Routing modules are below the app, features, and UI layers."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/ui/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/**",
                  "@/features/**",
                  "@/api/**"
                ],
                "message": "ui foundation modules are product-agnostic and never import app, features, or API code."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/job-detail/**",
        "src/features/saved/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/**",
                  "@/features/catalogue/**",
                  "@/features/search/**"
                ],
                "message": "Job detail and saved screens read the posting domain, not the search or catalogue features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/jobs/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/**",
                  "@/features/catalogue/**",
                  "@/features/search/**",
                  "@/features/job-detail/**",
                  "@/features/saved/**"
                ],
                "message": "features/jobs holds shared posting parts and imports no other feature folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/cv/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/app/**",
                  "@/features/search/**",
                  "@/features/catalogue/**",
                  "@/features/job-detail/**",
                  "@/features/saved/**"
                ],
                "message": "The CV feature is read by the search page; it does not read the screens that use it."
              }
            ]
          }
        ]
      }
    }
  ]
}
